# Storage bucket name untuk payment proofs (buat di Supabase Storage)
SUPABASE_STORAGE_BUCKET="payment-proofs"

# ----------------------------------------------------------------------------
# SECURITY SECRETS
# ----------------------------------------------------------------------------
# Generate dengan: npm run generate:secrets
# Atau manual: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# JWT Secret untuk authentication (minimal 32 karakter random)
JWT_SECRET=""

# Cron Secret untuk protect /api/cron/expire endpoint (minimal 32 karakter random)
CRON_SECRET=""

# ----------------------------------------------------------------------------
# PAYMENT - QRIS
# ----------------------------------------------------------------------------
# QRIS Merchant Payload (EMVCo format)
# Dapatkan dari: Bank/Payment Gateway Anda
# Kosongkan jika belum setup QRIS
STATIC_QRIS_PAYLOAD=""

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
# Domain production tanpa trailing slash
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

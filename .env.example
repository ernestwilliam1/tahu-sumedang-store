# ============================================================================
# TAHU SUMEDANG STORE - ENVIRONMENT VARIABLES
# ============================================================================
# 
# Panduan lengkap: docs/SUPABASE_CREDENTIALS.md
# Quick start: QUICK_START.md
#
# PENTING:
# 1. Copy file ini menjadi .env (jangan commit .env ke Git!)
# 2. Isi semua nilai yang dibutuhkan
# 3. Untuk production, gunakan nilai yang sama di Vercel Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE - SUPABASE POSTGRESQL
# ----------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection string
#
# PRODUCTION (Vercel): Gunakan "Connection pooling" (port 6543)
# Format: postgresql://postgres.xxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DEVELOPMENT (Local): Gunakan "Direct connection" (port 5432)  
# Format: postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres
#
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# ----------------------------------------------------------------------------
# SUPABASE - API & STORAGE
# ----------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard → Settings → API
#
# Project URL (sama untuk publik dan server)
NEXT_PUBLIC_SUPABASE_URL="hhttps://ecnrncvsflyqdgpzbtdr.supabase.co"
SUPABASE_URL="https://ecnrncvsflyqdgpzbtdr.supabase.co"

# Anon Key - aman untuk client/browser (ada RLS protection)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjbnJuY3ZzZmx5cWRncHpidGRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUzNTA4NDMsImV4cCI6MjExMDkyNjg0M30.wAoRMMLhpIPIgn1FgYfV4Fa_hYoWedtlWcaxkmrUSIA"


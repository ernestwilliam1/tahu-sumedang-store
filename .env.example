# Salin ke .env lalu isi nilainya. Jangan commit .env.

# PostgreSQL (Supabase / Neon / Vercel Postgres). Wajib untuk deploy.
# Supabase: Dashboard → Settings → Database → Connection string → "Connection pooling" (port 6543)
# Dipakai Vercel. Untuk `prisma db push` / seed dari terminal, pakai "Direct connection" (port 5432).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# String acak minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Payload QRIS statis milik merchant (EMVCo). Salin dari QRIS yang diterbitkan bank.
STATIC_QRIS_PAYLOAD=""

# Domain produksi, tanpa trailing slash. Dipakai metadata, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL="https://tahu-sumedang.vercel.app"

# Penyimpanan bukti transfer (Supabase Storage). Kosongkan saat dev lokal — file akan
# ditulis ke public/images/payments/ dan tidak dipakai di produksi.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="payment-proofs"

# Opsional. Bila diisi, /api/cron/expire hanya menerima `Authorization: Bearer <nilai ini>`.
# Vercel Cron mengirim header tersebut otomatis. Wajib diisi di produksi.
CRON_SECRET=""
